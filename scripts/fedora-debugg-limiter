#!/usr/bin/env bash
# Root-side helper behind the tachometer "Set limiters" form.
#
# Installed root-owned as /usr/local/sbin/fedora-debugg-limiter by
# scripts/install_limiter_controls.sh, with a sudoers rule that lets one user
# run exactly this file without a password. It accepts only:
#   check                 confirm the helper is installed and runnable
#   gpu-power <watts>     set the NVIDIA power cap (validated against the card's
#                         range) and persist it for fedora-debugg-gpu-power-limit.service
#   profile <name>        switch the tuned profile (must be one tuned lists)
set -euo pipefail

if [ "${EUID}" -eq 0 ]; then
  # Never trust the caller's environment when running privileged.
  PATH=/usr/sbin:/usr/bin:/sbin:/bin
  CONF=/etc/fedora-debugg/gpu-power-limit.conf
  UNIT_FILE=/etc/systemd/system/fedora-debugg-gpu-power-limit.service
else
  # Unprivileged runs are only useful to the tests, which point these at fakes.
  CONF="${FEDORA_DEBUGG_LIMITER_CONF:-/etc/fedora-debugg/gpu-power-limit.conf}"
  UNIT_FILE="${FEDORA_DEBUGG_LIMITER_UNIT:-/etc/systemd/system/fedora-debugg-gpu-power-limit.service}"
fi

die() {
  echo "fedora-debugg-limiter: $*" >&2
  exit 1
}

gpu_range() {
  # Prints "min max" in whole watts for the first GPU.
  nvidia-smi --query-gpu=power.min_limit,power.max_limit --format=csv,noheader,nounits \
    | head -1 | awk -F', *' '{ printf "%d %d\n", $1, $2 }'
}

tuned_profiles() {
  tuned-adm list 2>/dev/null | awk '/^- / { print $2 }'
}

case "${1:-}" in
  check)
    echo "ok"
    ;;
  gpu-power)
    watts="${2:-}"
    [[ "${watts}" =~ ^[0-9]{2,4}$ ]] || die "gpu-power needs a whole number of watts"
    command -v nvidia-smi >/dev/null 2>&1 || die "nvidia-smi is not available"
    read -r min_w max_w < <(gpu_range)
    if [ "${watts}" -lt "${min_w}" ] || [ "${watts}" -gt "${max_w}" ]; then
      die "${watts} W is outside this GPU's range of ${min_w}-${max_w} W"
    fi
    nvidia-smi --power-limit="${watts}" >/dev/null
    if [ -f "${UNIT_FILE}" ]; then
      install -d -m 0755 "$(dirname "${CONF}")"
      printf '# Written by fedora-debugg-limiter\nGPU_POWER_LIMIT_W=%s\n' "${watts}" >"${CONF}"
      echo "GPU power limit set to ${watts} W and kept for future boots"
    else
      echo "GPU power limit set to ${watts} W (until reboot; run install_gpu_power_limit.sh to persist)"
    fi
    ;;
  profile)
    name="${2:-}"
    [[ "${name}" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]] || die "profile needs a tuned profile name"
    command -v tuned-adm >/dev/null 2>&1 || die "tuned-adm is not available"
    tuned_profiles | grep -qxF -- "${name}" || die "unknown tuned profile: ${name}"
    tuned-adm profile "${name}"
    echo "Power profile set to ${name}"
    ;;
  *)
    echo "usage: fedora-debugg-limiter check | gpu-power <watts> | profile <name>" >&2
    exit 2
    ;;
esac
