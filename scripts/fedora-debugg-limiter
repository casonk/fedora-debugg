#!/usr/bin/env bash
# Root-side helper behind the tachometer "Set limiters" form.
#
# Installed root-owned as /usr/local/sbin/fedora-debugg-limiter by
# scripts/install_limiter_controls.sh, with a sudoers rule that lets one user
# run exactly this file without a password. It accepts only:
#   check                 confirm the helper is installed and runnable
#   gpu-power <watts>     set the NVIDIA power cap (validated against the card's
#                         range) and persist it for fedora-debugg-gpu-power-limit.service
#   profile <name>        switch the tuned profile (must be one tuned lists)
#   disk-scheduler <disk> <scheduler>
#                         set a whole disk's I/O scheduler (one the kernel offers for it)
#   read-ahead <dev> <KiB>
#                         set the read-ahead of a whole disk or a device-mapper
#                         volume (LUKS), 128 KiB to 16 MiB in powers of two
#   disk-reset <dev>      drop this device's overrides and reapply the defaults
#                         from 61-fedora-debugg-io-tuning.rules
# Disk changes apply now and are kept in 62-fedora-debugg-io-overrides.rules,
# keyed by the drive's serial (or the volume's name), so they follow the drive
# if it moves to another port.
set -euo pipefail

if [ "${EUID}" -eq 0 ]; then
  # Never trust the caller's environment when running privileged.
  PATH=/usr/sbin:/usr/bin:/sbin:/bin
  CONF=/etc/fedora-debugg/gpu-power-limit.conf
  UNIT_FILE=/etc/systemd/system/fedora-debugg-gpu-power-limit.service
  SYS_BLOCK=/sys/block
  IO_RULES=/etc/udev/rules.d/62-fedora-debugg-io-overrides.rules
else
  # Unprivileged runs are only useful to the tests, which point these at fakes.
  CONF="${FEDORA_DEBUGG_LIMITER_CONF:-/etc/fedora-debugg/gpu-power-limit.conf}"
  UNIT_FILE="${FEDORA_DEBUGG_LIMITER_UNIT:-/etc/systemd/system/fedora-debugg-gpu-power-limit.service}"
  SYS_BLOCK="${FEDORA_DEBUGG_LIMITER_SYS_BLOCK:-/sys/block}"
  IO_RULES="${FEDORA_DEBUGG_LIMITER_IO_RULES:-/etc/udev/rules.d/62-fedora-debugg-io-overrides.rules}"
fi

die() {
  echo "fedora-debugg-limiter: $*" >&2
  exit 1
}

gpu_range() {
  # Prints "min max" in whole watts for the first GPU.
  nvidia-smi --query-gpu=power.min_limit,power.max_limit --format=csv,noheader,nounits \
    | head -1 | awk -F', *' '{ printf "%d %d\n", $1, $2 }'
}

tuned_profiles() {
  tuned-adm list 2>/dev/null | awk '/^- / { print $2 }'
}

disk_device() {
  # A block device name this helper may touch: whole disks, and dm volumes when $2 allows.
  local dev="$1" allow_dm="${2:-no}"
  if [[ "${dev}" =~ ^(sd[a-z]{1,3}|nvme[0-9]{1,3}n[0-9]{1,3})$ ]]; then
    :
  elif [ "${allow_dm}" = yes ] && [[ "${dev}" =~ ^dm-[0-9]{1,4}$ ]]; then
    :
  else
    die "not a device this helper may change: ${dev}"
  fi
  [ -d "${SYS_BLOCK}/${dev}/queue" ] || die "no such device: ${dev}"
}

override_match() {
  # The udev match that names this device across reboots and port changes.
  local dev="$1" key value
  if [[ "${dev}" == dm-* ]]; then
    key=DM_NAME
  else
    key=ID_SERIAL
  fi
  value="$(udevadm info --query=property --name="/dev/${dev}" 2>/dev/null | sed -n "s/^${key}=//p" | head -1)"
  [[ "${value}" =~ ^[A-Za-z0-9_.:-]{1,128}$ ]] || die "cannot identify ${dev} by ${key}"
  printf 'ENV{%s}=="%s"' "${key}" "${value}"
}

save_override() {
  # Replace this device's line for one attribute in the overrides rule file.
  local match="$1" attr="$2" value="$3" tag tmp
  tag="# fedora-debugg-override ${match} ${attr}"
  install -d -m 0755 "$(dirname "${IO_RULES}")"
  tmp="$(mktemp "${IO_RULES}.XXXXXX")"
  if [ -f "${IO_RULES}" ]; then
    grep -vF -- "${tag}" "${IO_RULES}" >"${tmp}" || true
  else
    printf '# Written by fedora-debugg-limiter: per-device overrides of 61-fedora-debugg-io-tuning.rules\n' >"${tmp}"
  fi
  printf 'ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", %s, ATTR{%s}="%s"  %s\n' \
    "${match}" "${attr}" "${value}" "${tag}" >>"${tmp}"
  chmod 0644 "${tmp}"
  mv -f "${tmp}" "${IO_RULES}"
  udevadm control --reload 2>/dev/null || true
}

case "${1:-}" in
  check)
    echo "ok"
    ;;
  gpu-power)
    watts="${2:-}"
    [[ "${watts}" =~ ^[0-9]{2,4}$ ]] || die "gpu-power needs a whole number of watts"
    command -v nvidia-smi >/dev/null 2>&1 || die "nvidia-smi is not available"
    read -r min_w max_w < <(gpu_range)
    if [ "${watts}" -lt "${min_w}" ] || [ "${watts}" -gt "${max_w}" ]; then
      die "${watts} W is outside this GPU's range of ${min_w}-${max_w} W"
    fi
    nvidia-smi --power-limit="${watts}" >/dev/null
    if [ -f "${UNIT_FILE}" ]; then
      install -d -m 0755 "$(dirname "${CONF}")"
      printf '# Written by fedora-debugg-limiter\nGPU_POWER_LIMIT_W=%s\n' "${watts}" >"${CONF}"
      echo "GPU power limit set to ${watts} W and kept for future boots"
    else
      echo "GPU power limit set to ${watts} W (until reboot; run install_gpu_power_limit.sh to persist)"
    fi
    ;;
  profile)
    name="${2:-}"
    [[ "${name}" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]] || die "profile needs a tuned profile name"
    command -v tuned-adm >/dev/null 2>&1 || die "tuned-adm is not available"
    tuned_profiles | grep -qxF -- "${name}" || die "unknown tuned profile: ${name}"
    tuned-adm profile "${name}"
    echo "Power profile set to ${name}"
    ;;
  disk-scheduler)
    dev="${2:-}" scheduler="${3:-}"
    disk_device "${dev}"
    [[ "${scheduler}" =~ ^[a-z0-9-]{1,32}$ ]] || die "disk-scheduler needs a scheduler name"
    available="$(tr -d '[]' <"${SYS_BLOCK}/${dev}/queue/scheduler")"
    printf '%s\n' ${available} | grep -qxF -- "${scheduler}" \
      || die "${dev} offers only: ${available}"
    match="$(override_match "${dev}")"
    echo "${scheduler}" >"${SYS_BLOCK}/${dev}/queue/scheduler"
    save_override "${match}" "queue/scheduler" "${scheduler}"
    echo "${dev} scheduler set to ${scheduler} and kept for future boots"
    ;;
  read-ahead)
    dev="${2:-}" kb="${3:-}"
    disk_device "${dev}" yes
    case "${kb}" in
      128|256|512|1024|2048|4096|8192|16384) ;;
      *) die "read-ahead must be 128-16384 KiB in powers of two" ;;
    esac
    match="$(override_match "${dev}")"
    echo "${kb}" >"${SYS_BLOCK}/${dev}/queue/read_ahead_kb"
    save_override "${match}" "bdi/read_ahead_kb" "${kb}"
    echo "${dev} read-ahead set to ${kb} KiB and kept for future boots"
    ;;
  disk-reset)
    dev="${2:-}"
    disk_device "${dev}" yes
    match="$(override_match "${dev}")"
    if [ -f "${IO_RULES}" ]; then
      tmp="$(mktemp "${IO_RULES}.XXXXXX")"
      grep -vF -- "# fedora-debugg-override ${match} " "${IO_RULES}" >"${tmp}" || true
      chmod 0644 "${tmp}"
      mv -f "${tmp}" "${IO_RULES}"
    fi
    udevadm control --reload
    udevadm trigger --action=change --sysname-match="${dev}"
    udevadm settle --timeout=10 || true
    echo "${dev} back to the defaults for its drive type"
    ;;
  *)
    echo "usage: fedora-debugg-limiter check | gpu-power <watts> | profile <name>" \
      "| disk-scheduler <disk> <scheduler> | read-ahead <dev> <KiB> | disk-reset <dev>" >&2
    exit 2
    ;;
esac
